//@version=6
indicator("Elliott Wave Numbers - FINAL v6", overlay=true, max_labels_count=500)

// Inputs
pivot_length = input.int(5, "Pivot Length", minval=2, maxval=20)
show_table = input.bool(true, "Show Status Table")

// Pivot detection
pivot_high = ta.pivothigh(high, pivot_length, pivot_length)
pivot_low = ta.pivotlow(low, pivot_length, pivot_length)

// Sequential wave counters — each pivot gets ONE individual wave number
// High pivots cycle through: ① → ③ → ⑤ → ① → ...
// Low  pivots cycle through: ② → ④ → ② → ...
var int high_wave_idx = 0
var int low_wave_idx  = 0

var high_wave_labels = array.from("①", "③", "⑤")
var low_wave_labels  = array.from("②", "④")

// Label LOW pivots — individual wave number (② or ④)
if not na(pivot_low)
    lbl = array.get(low_wave_labels, low_wave_idx % array.size(low_wave_labels))
    label.new(bar_index[pivot_length], low[pivot_length], lbl,
              color=color.new(color.orange, 0),
              style=label.style_label_up,
              size=size.normal,
              textcolor=color.white)
    low_wave_idx := low_wave_idx + 1

// Label HIGH pivots — individual wave number (①, ③, or ⑤)
if not na(pivot_high)
    lbl = array.get(high_wave_labels, high_wave_idx % array.size(high_wave_labels))
    label.new(bar_index[pivot_length], high[pivot_length], lbl,
              color=color.new(color.purple, 0),
              style=label.style_label_down,
              size=size.normal,
              textcolor=color.white)
    high_wave_idx := high_wave_idx + 1

// Status Table (Top Right)
if barstate.islast and show_table
    var status_table = table.new(position.top_right, 2, 7,
                                 bgcolor=color.new(color.white, 80),
                                 border_width=2)

    // Header
    table.cell(status_table, 0, 0, "✅ ELLIOTT WAVE v6",
               bgcolor=color.new(color.green, 30),
               text_color=color.white, text_size=size.large)
    table.cell(status_table, 1, 0, "Pivot: " + str.tostring(pivot_length),
               bgcolor=color.new(color.green, 30),
               text_color=color.white, text_size=size.small)

    // Wave explanations
    table.cell(status_table, 0, 1, "② ④ ORANGE",
               bgcolor=color.new(color.orange, 70),
               text_color=color.white, text_size=size.small)
    table.cell(status_table, 1, 1, "LOW PIVOTS\n(Wave 2, 4)",
               text_color=color.black, text_size=size.tiny)

    table.cell(status_table, 0, 2, "① ③ ⑤ PURPLE",
               bgcolor=color.new(color.purple, 70),
               text_color=color.white, text_size=size.small)
    table.cell(status_table, 1, 2, "HIGH PIVOTS\n(Wave 1, 3, 5)",
               text_color=color.black, text_size=size.tiny)

    // Instructions
    table.cell(status_table, 0, 3, "🎯 INSTRUCTIONS",
               bgcolor=color.new(color.navy, 50),
               text_color=color.white, text_size=size.small)
    table.cell(status_table, 1, 3, "1. Zoom Out\n2. Scroll Left\n3. Pivot 3-8",
               text_color=color.yellow, text_size=size.tiny)

    // Best timeframes
    table.cell(status_table, 0, 4, "⏰ BEST TF",
               bgcolor=color.new(color.blue, 50),
               text_color=color.white, text_size=size.small)
    table.cell(status_table, 1, 4, "NIFTY: 15m/1H\nBNF: 5m/15m",
               text_color=color.aqua, text_size=size.tiny)

    // Alerts info
    table.cell(status_table, 0, 5, "🔔 ALERTS",
               bgcolor=color.new(color.maroon, 50),
               text_color=color.white, text_size=size.small)
    table.cell(status_table, 1, 5, "High/Low\nPivot Alerts",
               text_color=color.yellow, text_size=size.tiny)

// Alerts
alertcondition(not na(pivot_high), "Wave High Pivot", "High pivot (① ③ ⑤) detected!")
alertcondition(not na(pivot_low),  "Wave Low Pivot",  "Low pivot (② ④) detected!")

// Plot invisible line to force history calculation
plot(na, title="Force History")
